@inproceedings{zora255635,
       booktitle = {The AAAI Workshop on Artificial Intelligence Safety 2023 (SafeAI 2023)},
            year = {2023},
          series = {CEUR Workshop Proceedings},
          number = {3381},
       publisher = {CEUR-WS},
         address = {Washington, D.C},
           title = {A Framework Quantifying Trustworthiness of Supervised Machine and Deep Learning Models},
           month = {February},
           pages = {1--14},
          author = {Alberto Huertas Celdran and Jan Kreischer and Melike Demirci and Joel Leupp and Pedro Miguel S{\'a}nchez S{\'a}nchez and Muriel Figueredo Franco and G{\'e}r{\^o}me Bovet and Gregorio Mart{\'i}nez P{\'e}rez and Burkhard Stiller},
        abstract = {Trusting Artificial Intelligence (AI) is controversial since models and predictions might not be fair, understandable by humans, robust against adversaries, or trained appropriately. Existing toolkits help data scientists to create fair, explainable, robust, and transparent Machine and Deep Learning (ML/DL) models. However, tools to quantify AI trustworthiness according to pillars and metrics relevant for heterogeneous scenarios are still missing. This work proposes a novel algorithm that quantifies the trustworthiness level of supervised ML/DL models according to their fairness, explainability, robustness, and accountability.
The algorithm is deployed on a Web application to allow the general public to calculate the trustworthiness of their models. Finally, a validation scenario with models classifying cyberattacks demonstrates the applicability of the Web application and algorithm.},
             url = {https://doi.org/10.5167/uzh-255635},
        language = {english},
            issn = {1613-0073},
},

