\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Illustration of Beta distributions for different parameter values \((\alpha ,\beta )\). The blue curve \((\alpha =1,\beta =1)\) corresponds to a uniform distribution reflecting total ignorance (no evidence). The orange curve \((\alpha =2,\beta =2)\) reflects weak, symmetric evidence. The green curve \((\alpha =10,\beta =10)\) reflects strong, symmetric evidence, yielding high confidence around \(P(X=1)=0.5\). The red curve \((\alpha =5,\beta =1)\) reflects strong evidence skewed toward \(X=1\). Together, these illustrate how second-order uncertainty over \(P(X = 1)\) varies from concentrated to highly uncertain as the amount and balance of evidence change.}}{15}{figure.caption.33}\protected@file@percent }
\newlabel{fig:beta_distribution}{{2.1}{15}{Illustration of Beta distributions for different parameter values \((\alpha ,\beta )\). The blue curve \((\alpha =1,\beta =1)\) corresponds to a uniform distribution reflecting total ignorance (no evidence). The orange curve \((\alpha =2,\beta =2)\) reflects weak, symmetric evidence. The green curve \((\alpha =10,\beta =10)\) reflects strong, symmetric evidence, yielding high confidence around \(P(X=1)=0.5\). The red curve \((\alpha =5,\beta =1)\) reflects strong evidence skewed toward \(X=1\). Together, these illustrate how second-order uncertainty over \(P(X = 1)\) varies from concentrated to highly uncertain as the amount and balance of evidence change}{figure.caption.33}{}}
\newlabel{fig:beta_distribution@cref}{{[figure][1][2]2.1}{[1][15][]15}{}{}{}}
\newlabel{def:dir}{{2.2}{15}{Dirichlet Distribution}{definition.2}{}}
\newlabel{def:dir@cref}{{[definition][2][2]2.2}{[1][15][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Example of Dirichlet probability densities over the 2-simplex (visualized in barycentric coordinates). The concentration vector \(\boldsymbol  {\alpha } = [1,1,1]\) (top left) corresponds to the uniform distribution, reflecting no evidence for any outcome. \(\boldsymbol  {\alpha } = [5,1,1]\) (top right) reflects strong evidence favoring the first outcome. \(\boldsymbol  {\alpha } = [5,5,1]\) (bottom left) reflects evidence split between the first two outcomes. \(\boldsymbol  {\alpha } = [10,10,10] \)(bottom right) reflects strong, balanced evidence across all three outcomes, yielding high confidence concentrated at the centroid.}}{16}{figure.caption.34}\protected@file@percent }
\newlabel{fig:dirichlet_distribution}{{2.2}{16}{Example of Dirichlet probability densities over the 2-simplex (visualized in barycentric coordinates). The concentration vector \(\boldsymbol {\alpha } = [1,1,1]\) (top left) corresponds to the uniform distribution, reflecting no evidence for any outcome. \(\boldsymbol {\alpha } = [5,1,1]\) (top right) reflects strong evidence favoring the first outcome. \(\boldsymbol {\alpha } = [5,5,1]\) (bottom left) reflects evidence split between the first two outcomes. \(\boldsymbol {\alpha } = [10,10,10] \)(bottom right) reflects strong, balanced evidence across all three outcomes, yielding high confidence concentrated at the centroid}{figure.caption.34}{}}
\newlabel{fig:dirichlet_distribution@cref}{{[figure][2][2]2.2}{[1][16][]16}{}{}{}}
