\@writefile{toc}{\contentsline {paragraph}{Feature noise has limited impact on calibration.}{182}{section*.268}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{183}{section*.269}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Combined noise compounds the effect.}{183}{section*.270}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Uncertainty remains negligible.}{183}{section*.271}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{183}{subsection.9.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{183}{section*.272}\protected@file@percent }
\acronymused{PaTAS}
\@writefile{lof}{\contentsline {figure}{\numberline {9.8}{\ignorespaces Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text  {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$.}}{184}{figure.caption.273}\protected@file@percent }
\newlabel{fig:dynamic_trust_feature}{{9.8}{184}{Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$}{figure.caption.273}{}}
\newlabel{fig:dynamic_trust_feature@cref}{{[figure][8][9]9.8}{[1][184][]184}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{The model becomes less confident as noise increases.}{184}{section*.274}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{185}{section*.275}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{185}{section*.276}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{185}{subsection.9.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{185}{section*.277}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{185}{section*.278}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{185}{section*.279}\protected@file@percent }
