\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Trust opinion mapping at the input layer. Left: feature noise produces uncertainty-dominant opinions where $u$ grows with $\sigma _{\text  {rel}}$ following \Cref  {eq:feature_u}, reaching $u \approx 0.53$ at $\sigma _{\text  {rel}} = 0.6$. Right: label flipping produces disbelief-dominant opinions with a fixed residual uncertainty $u_0 = 0.2$, belief $b = (1-p)(1-u_0)$ decreasing from $0.8$ (for p close to $0$) to $0.52$ at $p=0.35$, and disbelief $d = p(1-u_0)$ rising symmetrically.}}{198}{figure.caption.334}\protected@file@percent }
\newlabel{fig:trust_mapping}{{9.1}{198}{Trust opinion mapping at the input layer. Left: feature noise produces uncertainty-dominant opinions where $u$ grows with $\sigma _{\text {rel}}$ following \Cref {eq:feature_u}, reaching $u \approx 0.53$ at $\sigma _{\text {rel}} = 0.6$. Right: label flipping produces disbelief-dominant opinions with a fixed residual uncertainty $u_0 = 0.2$, belief $b = (1-p)(1-u_0)$ decreasing from $0.8$ (for p close to $0$) to $0.52$ at $p=0.35$, and disbelief $d = p(1-u_0)$ rising symmetrically}{figure.caption.334}{}}
\newlabel{fig:trust_mapping@cref}{{[figure][1][9]9.1}{[1][198][]198}{}{}{}}
