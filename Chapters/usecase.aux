\@writefile{toc}{\contentsline {paragraph}{Feature noise has limited impact on calibration.}{209}{section*.351}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{209}{section*.352}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Combined noise compounds the effect.}{209}{section*.353}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Uncertainty remains negligible.}{209}{section*.354}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{209}{subsection.9.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{209}{section*.355}\protected@file@percent }
\acronymused{PaTAS}
\@writefile{lof}{\contentsline {figure}{\numberline {9.8}{\ignorespaces Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text  {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$.}}{210}{figure.caption.356}\protected@file@percent }
\newlabel{fig:dynamic_trust_feature}{{9.8}{210}{Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$}{figure.caption.356}{}}
\newlabel{fig:dynamic_trust_feature@cref}{{[figure][8][9]9.8}{[1][210][]210}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{The model becomes less confident as noise increases.}{210}{section*.357}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{211}{section*.358}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{211}{section*.359}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{211}{subsection.9.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{211}{section*.360}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{211}{section*.361}\protected@file@percent }
\acronymused{PaTAS}
