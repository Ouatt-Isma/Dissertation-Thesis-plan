\@writefile{toc}{\contentsline {paragraph}{Feature noise has limited impact on calibration.}{192}{section*.285}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{193}{section*.286}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Combined noise compounds the effect.}{193}{section*.287}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Uncertainty remains negligible.}{193}{section*.288}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{193}{subsection.9.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{193}{section*.289}\protected@file@percent }
\acronymused{PaTAS}
\@writefile{lof}{\contentsline {figure}{\numberline {9.8}{\ignorespaces Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text  {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$.}}{194}{figure.caption.290}\protected@file@percent }
\newlabel{fig:dynamic_trust_feature}{{9.8}{194}{Dynamic calibration trust assessment under feature noise across four noise levels (rows). Left: count of correct and incorrect predictions per softmax confidence bin. Center: proportion of correct and incorrect predictions per calibration belief bin $b$. Right: mean calibration trust opinion components $(b, d, u)$ per softmax confidence bin. Each row corresponds to $\sigma _{\text {rel}} \in \{0.00, 0.10, 0.30, 0.50\}$}{figure.caption.290}{}}
\newlabel{fig:dynamic_trust_feature@cref}{{[figure][8][9]9.8}{[1][194][]194}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{The model becomes less confident as noise increases.}{194}{section*.291}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{195}{section*.292}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{195}{section*.293}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{195}{subsection.9.6.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{195}{section*.294}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{195}{section*.295}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{195}{section*.296}\protected@file@percent }
