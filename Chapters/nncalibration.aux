\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces Overview of the calibration-based trust assessment pipeline. Predicted probabilities are partitioned into $M$ clusters; calibration evidence $(r_i, s_i)$ is extracted per cluster; each cluster yields a Subjective Logic opinion $\omega _i = (b_i, d_i, u_i, a_i)$; opinions are fused hierarchically, first across clusters, then across classes to produce a global trust opinion $\omega $.}}{153}{figure.caption.224}\protected@file@percent }
\newlabel{fig:pipeline}{{8.1}{153}{Overview of the calibration-based trust assessment pipeline. Predicted probabilities are partitioned into $M$ clusters; calibration evidence $(r_i, s_i)$ is extracted per cluster; each cluster yields a Subjective Logic opinion $\omega _i = (b_i, d_i, u_i, a_i)$; opinions are fused hierarchically, first across clusters, then across classes to produce a global trust opinion $\omega $}{figure.caption.224}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][8]8.1}{[1][152][]153}{}{}{}}
