\@writefile{lot}{\contentsline {table}{\numberline {6.2}{\ignorespaces Trust-source catalogue, grouped by lifecycle stage and risk category, with the property each risk category informs (Represent.\ = representativeness; Integrity = freedom from leakage) and the typical granularity ($\textsf  {D}$ = dataset, $\textsf  {E}$ = entry, $\textsf  {F}$ = feature). Risk categories follow the bias taxonomies of~\blx@tocontentsinit {0}\cite {10.1145/3457607,Suresh_2021}; the trust sources are adapted from the dataset-documentation practices of~\blx@tocontentsinit {0}\cite {gebru2018datasheets,Pushkarna2022DataCP}. The catalogue is extensible; \cref  {sec:dataset-trust:applications:compas} defines the trust sources actually used in this thesis.}}{106}{table.caption.173}\protected@file@percent }
\newlabel{tab:dataset-trust:catalogue}{{6.2}{106}{Trust-source catalogue, grouped by lifecycle stage and risk category, with the property each risk category informs (Represent.\ = representativeness; Integrity = freedom from leakage) and the typical granularity ($\dGran $ = dataset, $\eGran $ = entry, $\fGran $ = feature). Risk categories follow the bias taxonomies of~\cite {10.1145/3457607,Suresh_2021}; the trust sources are adapted from the dataset-documentation practices of~\cite {gebru2018datasheets,Pushkarna2022DataCP}. The catalogue is extensible; \cref {sec:dataset-trust:applications:compas} defines the trust sources actually used in this thesis}{table.caption.173}{}}
