\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Trust-expression tree for the running example of $\mathcal  {P}$ = reliability. The root combines its children with conjunction ($\wedge $): the dataset is reliable only if every lifecycle stage is reliable. Each stage-level node combines its metric-level children with aggregation ($\oplus $): the metrics attached to a stage all provide evidence for the same stage-level proposition and are fused rather than conjoined. Only a few representative metrics are shown per stage; the full catalogue is given in \cref  {tab:dataset-trust:catalogue}.}}{104}{figure.caption.152}\protected@file@percent }
\newlabel{fig:trust_expression_tree_dataset}{{6.1}{104}{Trust-expression tree for the running example of $\propP $ = reliability. The root combines its children with conjunction ($\wedge $): the dataset is reliable only if every lifecycle stage is reliable. Each stage-level node combines its metric-level children with aggregation ($\oplus $): the metrics attached to a stage all provide evidence for the same stage-level proposition and are fused rather than conjoined. Only a few representative metrics are shown per stage; the full catalogue is given in \cref {tab:dataset-trust:catalogue}}{figure.caption.152}{}}
\newlabel{fig:trust_expression_tree_dataset@cref}{{[figure][1][6]6.1}{[1][104][]104}{}{}{}}
