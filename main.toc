\contentsline {section}{\numberline {9.6}Calibration Quantification using Subjective Logic}{207}{section.9.6}%
\contentsline {subsection}{\numberline {9.6.1}Methodology Recap}{208}{subsection.9.6.1}%
\contentsline {subsection}{\numberline {9.6.2}Calibration Trust Across Noise Conditions}{208}{subsection.9.6.2}%
\contentsline {paragraph}{Feature noise has limited impact on calibration.}{209}{section*.351}%
\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{209}{section*.352}%
\contentsline {paragraph}{Combined noise compounds the effect.}{209}{section*.353}%
\contentsline {paragraph}{Uncertainty remains negligible.}{209}{section*.354}%
\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{209}{subsection.9.6.3}%
\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{209}{section*.355}%
\contentsline {paragraph}{The model becomes less confident as noise increases.}{210}{section*.357}%
\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{211}{section*.358}%
\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{211}{section*.359}%
\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{211}{subsection.9.6.4}%
\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{211}{section*.360}%
\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{211}{section*.361}%
\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{212}{section*.362}%
