\contentsline {subsection}{\numberline {9.6.1}Methodology Recap}{177}{subsection.9.6.1}%
\contentsline {subsection}{\numberline {9.6.2}Calibration Trust Across Noise Conditions}{178}{subsection.9.6.2}%
\contentsline {paragraph}{Feature noise has limited impact on calibration.}{178}{section*.282}%
\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{179}{section*.283}%
\contentsline {paragraph}{Combined noise compounds the effect.}{179}{section*.284}%
\contentsline {paragraph}{Uncertainty remains negligible.}{179}{section*.285}%
\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{179}{subsection.9.6.3}%
\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{179}{section*.286}%
\contentsline {paragraph}{The model becomes less confident as noise increases.}{180}{section*.288}%
\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{181}{section*.289}%
\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{181}{section*.290}%
\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{181}{subsection.9.6.4}%
\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{181}{section*.291}%
\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{181}{section*.292}%
\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{181}{section*.293}%
