\contentsline {subsection}{\numberline {9.6.1}Methodology Recap}{179}{subsection.9.6.1}%
\contentsline {subsection}{\numberline {9.6.2}Calibration Trust Across Noise Conditions}{180}{subsection.9.6.2}%
\contentsline {paragraph}{Feature noise has limited impact on calibration.}{180}{section*.267}%
\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{181}{section*.268}%
\contentsline {paragraph}{Combined noise compounds the effect.}{181}{section*.269}%
\contentsline {paragraph}{Uncertainty remains negligible.}{181}{section*.270}%
\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{181}{subsection.9.6.3}%
\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{181}{section*.271}%
\contentsline {paragraph}{The model becomes less confident as noise increases.}{182}{section*.273}%
\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{183}{section*.274}%
\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{183}{section*.275}%
\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{183}{subsection.9.6.4}%
\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{183}{section*.276}%
\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{183}{section*.277}%
\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{183}{section*.278}%
