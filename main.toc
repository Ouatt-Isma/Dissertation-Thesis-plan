\contentsline {section}{\numberline {9.6}Calibration Quantification using Subjective Logic}{181}{section.9.6}%
\contentsline {subsection}{\numberline {9.6.1}Methodology Recap}{181}{subsection.9.6.1}%
\contentsline {subsection}{\numberline {9.6.2}Calibration Trust Across Noise Conditions}{182}{subsection.9.6.2}%
\contentsline {paragraph}{Feature noise has limited impact on calibration.}{182}{section*.268}%
\contentsline {paragraph}{Label flipping causes substantial miscalibration.}{183}{section*.269}%
\contentsline {paragraph}{Combined noise compounds the effect.}{183}{section*.270}%
\contentsline {paragraph}{Uncertainty remains negligible.}{183}{section*.271}%
\contentsline {subsection}{\numberline {9.6.3}Dynamic Calibration Trust Assessment Under Feature Noise}{183}{subsection.9.6.3}%
\contentsline {paragraph}{Calibration belief increases monotonically with softmax confidence at low noise.}{183}{section*.272}%
\contentsline {paragraph}{The model becomes less confident as noise increases.}{184}{section*.274}%
\contentsline {paragraph}{At moderate noise, miscalibration emerges at mid-confidence bins.}{185}{section*.275}%
\contentsline {paragraph}{At high noise, calibration trust decouples from softmax confidence across the full spectrum.}{185}{section*.276}%
\contentsline {subsection}{\numberline {9.6.4}Dynamic Calibration Trust Assessment Under Label Noise}{185}{subsection.9.6.4}%
\contentsline {paragraph}{Label noise shifts the confidence distribution leftward more aggressively than feature noise.}{185}{section*.277}%
\contentsline {paragraph}{Calibration belief is elevated but flat across most confidence bins, reflecting systematic miscalibration.}{185}{section*.278}%
\contentsline {paragraph}{At high label noise, the highest confidence predictions become the most miscalibrated.}{185}{section*.279}%
\contentsline {subsection}{\numberline {9.6.5}Comparison: Per-Prediction Trust vs.\ Calibration Trust}{187}{subsection.9.6.5}%
